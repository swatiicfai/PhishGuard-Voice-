# ── Google Cloud ──────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# ── Vertex AI / Gemini Live ───────────────────────────────────────────────────
# Model to use for the Gemini Live audio session
GEMINI_LIVE_MODEL=gemini-2.0-flash-live-001

# ── Firebase / Firestore ──────────────────────────────────────────────────────
# Path to the Firebase service account key JSON (for local dev)
# On Cloud Run, use Workload Identity instead (leave blank)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Firestore database ID (usually "(default)")
FIRESTORE_DATABASE_ID=(default)

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the WebSocket & REST endpoints
ALLOWED_ORIGINS=http://localhost:5000,https://your-firebase-project.web.app

# ── App ───────────────────────────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=info
